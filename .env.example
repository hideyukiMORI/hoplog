APP_ENV=local
APP_DEBUG=true
APP_NAME="hoplog"

# SQLite (default for local dev)
DB_ADAPTER=sqlite
DB_NAME=/tmp/hoplog.sqlite
DB_HOST=localhost
DB_USER=hoplog
DB_PASSWORD=
DB_CHARSET=utf8mb4

