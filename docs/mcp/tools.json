{
  "tools": [
    {
      "name": "hoplog_list_breweries",
      "description": "List all breweries with pagination",
      "operationId": "listBreweries",
      "method": "GET",
      "path": "/breweries",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "default": 20
        },
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "default": 0
        }
      ]
    },
    {
      "name": "hoplog_get_brewery",
      "description": "Get a brewery by ID",
      "operationId": "getBreweryById",
      "method": "GET",
      "path": "/breweries/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "name": "hoplog_list_beers",
      "description": "List all beers with pagination",
      "operationId": "listBeers",
      "method": "GET",
      "path": "/beers",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "default": 20
        },
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "default": 0
        }
      ]
    },
    {
      "name": "hoplog_get_beer",
      "description": "Get a beer by ID",
      "operationId": "getBeerById",
      "method": "GET",
      "path": "/beers/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "name": "hoplog_list_tasting_notes",
      "description": "List tasting notes ordered by rated_at descending",
      "operationId": "listTastingNotes",
      "method": "GET",
      "path": "/tasting-notes",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "default": 20
        },
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "default": 0
        }
      ]
    },
    {
      "name": "hoplog_get_tasting_note",
      "description": "Get a tasting note by ID",
      "operationId": "getTastingNoteById",
      "method": "GET",
      "path": "/tasting-notes/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "required": true
        }
      ]
    }
  ]
}
